# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# Gmail address used to SEND the alerts
SENDER_EMAIL=your-gmail@gmail.com

# Gmail App Password (NOT your regular password).
# Generate one at: https://myaccount.google.com/apppasswords
SENDER_PASSWORD=xxxx xxxx xxxx xxxx

# Who receives the alerts (already set as the default in the script)
RECIPIENT_EMAIL=zeyangzhengzeus@gmail.com

# Shopify products endpoint (default works for uk.topps.com)
# TOPPS_PRODUCTS_URL=https://uk.topps.com/products.json?limit=50&sort_by=created-descending

# Where to store the seen-products state file
# STATE_FILE=./known_products.json
